# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillforge

# API Configuration
PROJECT_NAME="SkillForge AI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000"]

# Local Qwen AI (Ollama)
QWEN_MODEL=qwen3:8b
QWEN_BASE_URL=http://localhost:11434
QWEN_TIMEOUT=120
QWEN_CONNECT_TIMEOUT=5
QWEN_TEMPERATURE=0.6
QWEN_NUM_CTX=8192
QWEN_THINK=false
QWEN_KEEP_ALIVE=10m
QWEN_MAX_HISTORY_MESSAGES=12
QWEN_MAX_HISTORY_CHARS=12000
QWEN_MAX_CONTEXT_CHARS=12000

# RAG (Retrieval-Augmented Generation) evidence layer
# Feeds SkillForgeContext.evidence for the Qwen chat endpoint. Isolated from
# QWEN_* on purpose: a bad RAG_* value disables retrieval, never the chat
# endpoint itself.
RAG_ENABLED=true

# Embedding model served by Ollama. Must be an embedding model, never the
# Qwen3 8B generation model (QWEN_MODEL above).
RAG_EMBEDDING_MODEL=qwen3-embedding:8b
RAG_OLLAMA_BASE_URL=http://localhost:11434

# Vector width stored in rag_chunks.embedding (fixed at migration time).
# 1024 is a safe default well under pgvector's ~2000-dim HNSW indexing
# ceiling. If your local RAG_EMBEDDING_MODEL returns a different native
# dimension, ingestion will fail fast with a clear error rather than
# silently corrupt vectors — confirm the real output size (e.g. via a test
# call to Ollama's /api/embed) before changing this in production, since it
# requires a new migration and a full re-ingest of all documents.
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_TIMEOUT=60
RAG_EMBEDDING_CONNECT_TIMEOUT=5
RAG_EMBEDDING_BATCH_SIZE=16

# Retrieval budgets
RAG_TOP_K=8
RAG_CANDIDATE_K=20
RAG_RRF_K=60

# Chunking (characters, not tokens)
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200
RAG_MAX_EVIDENCE_CONTENT_CHARS=1400
