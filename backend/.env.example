# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillforge

# API Configuration
PROJECT_NAME="SkillForge AI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000"]

# Adzuna API Configuration (Post-MVP P1 Market Ingestion)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Local Ollama / Qwen 3 8B Configuration (Post-MVP P2 AI Foundation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60.0

# Google Gemini API Configuration (Post-MVP Career Roadmap PDF Foundation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
