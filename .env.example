# Database Configuration
# Local PostgreSQL with pgvector (Homebrew or Docker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillforge

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Settings
PROJECT_NAME="SkillForge AI"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Adzuna API Configuration (Post-MVP P1 Market Ingestion)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
